# Michael AI Assistant Configuration

# Telegram Bot (필수)
# BotFather에서 받은 토큰을 입력하세요
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Gateway Server (선택)
GATEWAY_PORT=18789
GATEWAY_HOST=127.0.0.1

# HTTP Server (선택)
HTTP_PORT=3000
# WEBAPP_URL - Mini App 접근 URL (프로덕션에서 HTTPS 필요)
# WEBAPP_URL=https://your-domain.com

# ngrok (for HTTPS tunneling in development)
# Get your authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Data Directory (선택)
DATA_DIR=./data

# Log Level (선택: debug, info, warn, error)
LOG_LEVEL=info

# 참고: Claude Code CLI를 사용하므로 ANTHROPIC_API_KEY는 필요 없습니다
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_PROVIDER=local

# Finance Agent (선택)
# Alpha Vantage API key for stock quotes (free tier: 5 req/min, 500/day)
# Get your free key at: https://www.alphavantage.co/support/#api-key
# ALPHA_VANTAGE_API_KEY=your_api_key_here
