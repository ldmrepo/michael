# Michael AI Assistant Configuration

# Telegram Bot (필수)
# BotFather에서 받은 토큰을 입력하세요
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Gateway Server (선택)
GATEWAY_PORT=18789
GATEWAY_HOST=127.0.0.1

# Data Directory (선택)
DATA_DIR=./data

# Log Level (선택: debug, info, warn, error)
LOG_LEVEL=info

# 참고: Claude Code CLI를 사용하므로 ANTHROPIC_API_KEY는 필요 없습니다
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_PROVIDER=local
