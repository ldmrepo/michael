      "height": 1280,
      "crop": "center"
    },
    "_meta": {"title": "Resize Image to Target"}
  },
  "8": {
    "class_type": "WanImageToVideo",
    "inputs": {
      "positive": ["5", 0],
      "negative": ["6", 0],
      "vae": ["4", 0],
